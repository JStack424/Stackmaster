<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <StackmasterVersion>0.1.0</StackmasterVersion>
    <Version>$(StackmasterVersion)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>JStack424</Authors>
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <StackmasterReferencePath Condition="'$(StackmasterReferencePath)' == ''">$(MSBuildThisFileDirectory)lib/local/StackmasterReferences</StackmasterReferencePath>
  </PropertyGroup>
</Project>
